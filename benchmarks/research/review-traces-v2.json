        "request": {
          "revision": 2,
          "text": "Revision 2: retry(attempts_so_far) receives the number of attempts already completed, starting at 0; return True only when attempts_so_far < 4. Replace revision 1's limit of 3.",
          "requirements": [
            {
              "id": "r1",
              "kind": "behavior",
              "text": "retry(attempts_so_far) returns True when attempts_so_far is less than 4, and False otherwise."
            }
          ]
        },
        "artifact": {
          "revision": 2,
          "digest": "tree-b",
          "facts": [
            {
              "kind": "code",
              "value": "def retry(attempts_so_far): return attempts_so_far < 4"
            }
          ],
          "preservation": []
        },
        "evidence": {
          "revision": 2,
          "artifact_digest": "tree-b",
          "observations": [
            {
              "requirement_id": "r1",
              "status": "PASS",
              "detail": "attempts_so_far=3 returns True and attempts_so_far=4 returns False"
            }
          ]
        }
      },
      "expected_verdict": "ready",
      "label_rationale": "Latest behavior must be implemented and evidence must cover the current requirement and tree."
