      "id": "scheduler-bounded-backoff",
      "repository": "repo-scheduler-backoff",
      "initial_request": "Make backoff_ms use exponential retry delays starting at the base delay and cap the result at 30000 milliseconds.",
      "mid_run_correction": "Preserve the base delay, attempt-zero semantics, cap, return type, and public function signature; only correct the retry schedule.",
      "hard_requirements": [
        "Attempt zero returns the base delay",
        "Each attempt doubles the delay",
        "The result never exceeds 30000 milliseconds"
      ],
      "forbidden_or_preservation": [
        "Do not change src/config.rs or unrelated modules",
        "Do not delete or weaken an existing test"
      ],
      "oracle": "oracles/repo_scheduler_backoff.rs",
      "test_integrity": ["src/backoff.rs"],
      "unchanged_paths": ["src/config.rs"],
      "mutations": {
        "baseline": {"operations": [], "expected_external_accepted": false},
        "gold": {
          "operations": [
            {"op": "replace_once", "path": "src/backoff.rs", "old": "base_ms.saturating_mul(attempt as u64)", "new": "base_ms.saturating_mul(1u64 << attempt.min(4)).min(MAX_BACKOFF_MS)"}
          ],
          "expected_external_accepted": true
        },
        "stale": {
          "operations": [
            {"op": "replace_once", "path": "src/backoff.rs", "old": "base_ms.saturating_mul(attempt as u64)", "new": "base_ms.saturating_mul(1u64 << attempt.min(4)).min(MAX_BACKOFF_MS)"},
            {"op": "replace_once", "path": "src/backoff.rs", "old": "attempt.min(4)", "new": "attempt.min(3)"}
          ],
          "expected_external_accepted": false
        },
        "overbroad": {
          "operations": [
            {"op": "replace_once", "path": "src/backoff.rs", "old": "base_ms.saturating_mul(attempt as u64)", "new": "base_ms.saturating_mul(1u64 << attempt.min(4)).min(MAX_BACKOFF_MS)"},
            {"op": "replace_once", "path": "src/config.rs", "old": "DEFAULT_QUEUE: &str = \"default\"", "new": "DEFAULT_QUEUE: &str = \"priority\""}
