            {"op": "replace_once", "path": "src/backoff.rs", "old": "base_ms.saturating_mul(attempt as u64)", "new": "base_ms.saturating_mul(1u64 << attempt.min(4)).min(MAX_BACKOFF_MS)"},
            {"op": "remove_line", "path": "src/backoff.rs", "line": "        assert!(backoff_ms(10, 2) <= MAX_BACKOFF_MS);"}
          ],
          "expected_external_accepted": false
