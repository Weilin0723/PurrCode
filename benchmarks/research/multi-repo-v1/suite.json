{
  "schema_version": 1,
  "status": "design_only",
  "benchmark_kind": "multi_repository_repository_completion",
  "description": "Six independently rooted, locally authored Rust repositories with one bounded completion task each. This is a design and preflight artifact; it contains no model outcomes.",
  "provenance": {
    "authored_locally": true,
    "external_repositories": false,
    "generalization_claim": "none",
    "reason_for_separation": "Each task has its own repository root, Cargo manifest, source files, public tests, and isolated behavior oracle. No task imports source from another repository."
  },
  "independent_unit": "repository_root",
  "candidate_types": [
    "baseline",
    "gold",
    "stale",
    "overbroad",
    "test_tampering",
    "gold_stale_evidence"
  ],
  "prompt_conditions": [
    "revision_rubric_json",
    "plain_json"
  ],
  "replicates": [17, 29],
  "model_policy": "Select and record one qualified model alias before any live call. Do not choose a model, prompt, repository, or task by outcome. This suite has no live results until a separate freeze and runner artifact exist.",
  "candidate_policy": {
    "gold_stale_evidence": {
      "source_candidate": "gold",
      "external_label": "accepted",
      "metadata": "current artifact revision/digest with stale evidence revision/digest",
      "expected_gate": "BLOCKED"
    },
    "expected_gate_by_candidate": {
      "baseline": "BLOCKED",
      "gold": "READY",
      "stale": "BLOCKED",
      "overbroad": "READY",
      "test_tampering": "READY"
    }
  },
  "run_plan": {
    "repositories": 6,
    "tasks_per_repository": 1,
    "task_clusters": 6,
    "candidates_per_task": 6,
    "prompt_conditions": 2,
    "replicates_per_candidate": 2,
    "scheduled_calls_per_model": 144,
    "unique_d_evaluations": 36,
    "primary_condition": "revision_rubric_json",
    "primary_endpoint": "C minus B external false-ready risk on externally rejected candidate snapshots",
    "schedule_order": "repository order, task order, candidate order listed above, condition order, then replicate label",
    "cluster_rule": "The repository root is the inferential cluster. Do not treat candidate rows or replicate labels as independent clusters.",
    "stop_rule": "Complete the frozen schedule or report operational inconclusiveness. Pause only for integrity, credential, provider, billing, or user interruption; resume only never-started indices from the identical freeze.",
    "exclusion_rule": "No outcome-based exclusions, replacements, candidate deletion, task deletion, repository deletion, or model substitution. Count invalid, timeout, provider-error, and missing-terminal rows in ITT attrition.",
    "guardrail": "Retain the existing five-percentage-point C-minus-B correct-coverage guardrail, report gold and gold_stale_evidence separately, and do not relax it after results are seen."
  },
  "repositories": [
    {
      "id": "repo-ledger-tax",
      "path": "repos/repo-ledger-tax",
      "crate_name": "research_ledger_tax",
      "task_ids": ["ledger-tax-rounding"],
      "fixture_files": ["Cargo.toml", "src/lib.rs", "src/config.rs", "src/tax.rs"]
    },
