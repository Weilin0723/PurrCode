{
  "name": "purrcode",
  "displayName": "PurrCode",
  "description": "Local-first autonomous coding agent — IDE Workbench, TUI, and GitHub-native delivery.",
  "version": "1.0.0",
  "publisher": "purrcode",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Machine Learning", "Other"],
  "activationEvents": [
    "onView:purrcode.workbench",
    "onView:purrcode.sessions"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {"command": "purrcode.start", "title": "PurrCode: Start Task"},
      {"command": "purrcode.startSelection", "title": "PurrCode: Start Task With Selection"},
      {"command": "purrcode.refresh", "title": "PurrCode: Refresh Sessions"},
      {"command": "purrcode.openSession", "title": "PurrCode: Open Session in Workbench"},
      {"command": "purrcode.openWorkbench", "title": "PurrCode: Focus Workbench"},
      {"command": "purrcode.openInTerminal", "title": "PurrCode: Open Current Session in Terminal"},
      {"command": "purrcode.resume", "title": "PurrCode: Resume Session"},
      {"command": "purrcode.approve", "title": "PurrCode: Approve Pending Action"},
      {"command": "purrcode.reject", "title": "PurrCode: Reject Pending Action"},
      {"command": "purrcode.pause", "title": "PurrCode: Pause Session"},
      {"command": "purrcode.cancel", "title": "PurrCode: Cancel Session"},
      {"command": "purrcode.checkpoint", "title": "PurrCode: Create Checkpoint"},
      {"command": "purrcode.rollback", "title": "PurrCode: Roll Back Isolated Changes"},
      {"command": "purrcode.compact", "title": "PurrCode: Compact Context"},
      {"command": "purrcode.selectModel", "title": "PurrCode: Select Session Model"},
      {"command": "purrcode.openDiff", "title": "PurrCode: Open Current File Diff"},
      {"command": "purrcode.applyHunk", "title": "PurrCode: Apply Reviewed Hunk"},
      {"command": "purrcode.rejectHunk", "title": "PurrCode: Reject Reviewed Hunk"},
      {"command": "purrcode.showEvidence", "title": "PurrCode: Show Session Evidence"},
      {"command": "purrcode.githubConnect", "title": "PurrCode: Connect GitHub"},
      {"command": "purrcode.githubCreatePR", "title": "PurrCode: Create Pull Request"},
      {"command": "purrcode.workflowDirect", "title": "PurrCode: Force Direct Workflow"},
      {"command": "purrcode.workflowStandard", "title": "PurrCode: Force Standard Workflow"},
      {"command": "purrcode.workflowUltra", "title": "PurrCode: Force Ultra Workflow"},
      {"command": "purrcode.workflowAuto", "title": "PurrCode: Auto Workflow"},
      {"command": "purrcode.searchOff", "title": "PurrCode: Search Off"},
      {"command": "purrcode.searchAuto", "title": "PurrCode: Search Auto"},
      {"command": "purrcode.searchAlways", "title": "PurrCode: Search Always"},
      {"command": "purrcode.viewUsage", "title": "PurrCode: View Session Usage"}
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "purrcode",
          "title": "PurrCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "purrcode": [
        {"id": "purrcode.workbench", "name": "Workbench", "type": "webview"},
        {"id": "purrcode.sessions", "name": "Sessions"}
      ]
    },
    "configuration": {
      "title": "PurrCode",
      "properties": {
        "purrcode.daemonUrl": {
          "type": "string",
          "default": "http://127.0.0.1:7377",
          "description": "Authenticated loopback PurrCode daemon URL."
        },
        "purrcode.tokenFile": {
          "type": "string",
          "default": "",
          "description": "Daemon token path. Empty uses the platform PurrCode data directory."
        },
        "purrcode.defaultTaskMode": {
          "type": "string",
          "default": "build",
          "enum": ["ask", "plan", "build", "review"],
          "description": "Default task mode for new sessions."
        },
        "purrcode.defaultPermission": {
          "type": "string",
          "default": "auto",
          "enum": ["ask", "auto", "full-access"],
          "description": "Default permission mode."
        },
        "purrcode.defaultExecutionStyle": {
          "type": "string",
          "default": "autonomous",
          "enum": ["autonomous", "collaborative"],
          "description": "Default execution style."
        },
        "purrcode.defaultWorkflow": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "direct", "standard", "ultra"],
          "description": "Default adaptive workflow profile."
        },
        "purrcode.defaultSearchPolicy": {
          "type": "string",
          "default": "auto",
          "enum": ["off", "auto", "always"],
          "description": "Default search scope."
        },
        "purrcode.defaultBudgetProfile": {
          "type": "string",
          "default": "balanced",
          "enum": ["economy", "balanced", "max-quality", "custom"],
          "description": "Default token and cost budget profile."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.0"
  }
}